# Geheimnisse: niemals einchecken
.env

# Python
.venv/
__pycache__/
*.pyc
.pytest_cache/
*.egg-info/
build/
dist/

# Messartefakte der Phase 0 werden bei jedem Lauf neu erzeugt.
spike/output/**

# Ausnahme: der Beleg-Kern der Messreihe, auf die sich ADR-001 stützt.
# Ohne ihn stünde die Architekturentscheidung ohne Nachweis da. Die
# Rohartefakte (Prompts, Modellantworten, Bundles, OperationOutcomes)
# bleiben ignoriert: Sie sind regenerierbar und machen den Unterschied
# zwischen 184 KB und 3,2 MB aus.
#
# Die beiden Verzeichnis-Ausnahmen sind zwingend: Git steigt in ein
# ausgeschlossenes Verzeichnis gar nicht erst hinein, Datei-Ausnahmen
# darin blieben also wirkungslos.
!spike/output/messreihe-02/
!spike/output/messreihe-02/**/
!spike/output/messreihe-02/bericht.md
!spike/output/messreihe-02/session.json
!spike/output/messreihe-02/**/metriken.json

# Ein Klon dieses Repositorys im Projektordner. Entsteht, wenn man zum
# Nachschauen hierher klont; git trüge ihn sonst als Submodul-Verweis ein
# und auf GitHub erschiene ein leerer, kaputter Ordner.
#
# Der führende Schrägstrich ist zwingend. Ohne ihn greift das Muster in
# JEDER Ebene, und weil git unter Windows Groß- und Kleinschreibung
# ignoriert (core.ignorecase=true), schloss es damit auch das Paket
# src/synthfhir/ aus: Bereits verfolgte Dateien blieben verfolgt, aber neue
# Module wären beim Commit stillschweigend liegen geblieben.
/SynthFHIR/
.claude/launch.json

# Werkzeuge, die nicht ins Repository gehoeren.
#
# validator_cli.jar ist 191 MiB gross und wird von HL7 verteilt - es
# gehoert geholt, nicht mitgeliefert. Die Messlaeufe darunter enthalten
# Serverantworten mit SNOMED-Bezeichnungen; die duerfen nach dem
# SNOMED-Affiliate-Lizenzvertrag nicht in ein oeffentliches Repository.
# Eingecheckt wird nur der abgeleitete Bericht.
/werkzeuge/
/messlauf/
/.txcache/
