# Geheimnisse: niemals einchecken
.env

# Python
.venv/
__pycache__/
*.pyc
.pytest_cache/
*.egg-info/
build/
dist/

# Messartefakte der Phase 0 werden bei jedem Lauf neu erzeugt.
spike/output/**

# Ausnahme: der Beleg-Kern der Messreihe, auf die sich ADR-001 stützt.
# Ohne ihn stünde die Architekturentscheidung ohne Nachweis da. Die
# Rohartefakte (Prompts, Modellantworten, Bundles, OperationOutcomes)
# bleiben ignoriert: Sie sind regenerierbar und machen den Unterschied
# zwischen 184 KB und 3,2 MB aus.
#
# Die beiden Verzeichnis-Ausnahmen sind zwingend: Git steigt in ein
# ausgeschlossenes Verzeichnis gar nicht erst hinein, Datei-Ausnahmen
# darin blieben also wirkungslos.
!spike/output/messreihe-02/
!spike/output/messreihe-02/**/
!spike/output/messreihe-02/bericht.md
!spike/output/messreihe-02/session.json
!spike/output/messreihe-02/**/metriken.json
