# ---------------------------------------------------------------------------
# SynthFHIR Phase-0-Spike - Umgebungsvariablen
# Diese Datei nach ".env" kopieren und ausfuellen. ".env" ist per .gitignore
# ausgeschlossen und darf niemals eingecheckt werden.
# ---------------------------------------------------------------------------

# --- LLM-Anbindung ---------------------------------------------------------
# Anbieter:
#   anthropic          kostenpflichtige Claude-API
#   openai_compatible  jeder Dienst mit /v1/chat/completions (Alias: ollama)
#   mock               Selbsttest ohne Kosten, KEINE Messgrundlage
#
# KOSTENLOSE WEGE, den Spike zu messen (alle über openai_compatible):
#   lokal per Ollama   SYNTHFHIR_LLM_BASE_URL=http://localhost:11434/v1
#                      SYNTHFHIR_LLM_MODEL=mistral:latest
#                      kein Schlüssel nötig, Daten verlassen den Rechner nicht
#   Groq               https://api.groq.com/openai/v1
#   OpenRouter         https://openrouter.ai/api/v1   (Modelle mit :free)
#   Mistral            https://api.mistral.ai/v1
#   Google AI Studio   https://generativelanguage.googleapis.com/v1beta/openai
# Bei den Cloud-Diensten den kostenlosen Schlüssel in SYNTHFHIR_LLM_API_KEY.
SYNTHFHIR_LLM_PROVIDER=anthropic

# API-Schlüssel des Anbieters. NUR hier, niemals im Code.
ANTHROPIC_API_KEY=
# Für openai_compatible (bei lokalem Ollama leer lassen):
SYNTHFHIR_LLM_API_KEY=

# Basis-URL des Anbieters. Für openai_compatible der Endpunkt des Dienstes;
# ohne Angabe zeigt der Adapter auf das lokale Ollama.
# Für anthropic nur nötig, wenn eine in der Umgebung gesetzte
# ANTHROPIC_BASE_URL überschrieben werden soll (z. B. ein Proxy, durch den
# die Messläufe sonst still umgeleitet würden).
# SYNTHFHIR_LLM_BASE_URL=https://api.anthropic.com

# Modell. Der Spike misst die Architektur, nicht die maximale Modellqualitaet,
# darum ist bewusst ein guenstiges Modell voreingestellt (Abschnitt 3 der Spec).
# Alternativen: claude-sonnet-5, claude-opus-5 (deutlich teurer).
SYNTHFHIR_LLM_MODEL=claude-haiku-4-5

# Temperatur. > 0, damit Wiederholungen desselben Szenarios unterschiedliche
# Antworten liefern - sonst misst man 20-mal denselben Einzelfall.
SYNTHFHIR_LLM_TEMPERATURE=0.8

# Obergrenze der Antwortlaenge je LLM-Aufruf.
# ACHTUNG: Anbieter rechnen max_tokens in die ANFRAGEGROESSE ein. Der Wert
# zaehlt also mit, auch wenn er nie ausgeschoepft wird.
#
# Rechnung fuer ein Kontingent von 8000 Token je Minute (Groq, kostenlos):
#
#   Prompt mit allen fuenf Katalogen   3016 Token   (gemessen 2026-08-30)
#   verbleibt fuer max_tokens          4984
#   gewaehlt mit Reserve               4800
#
# Hier stand einmal 16000 - direkt unter einem Kommentar, der davor warnt.
# Jede Anfrage scheiterte damit an HTTP 413. Wer das Kontingent groesser hat,
# darf den Wert erhoehen; wer es kleiner hat, muss ihn senken. Die
# Fehlermeldung nennt im Ernstfall den passenden Wert.
SYNTHFHIR_LLM_MAX_TOKENS=4800

# Optional: nur setzen, wenn das gewaehlte Modell es unterstuetzt.
# SYNTHFHIR_LLM_EFFORT=low
# SYNTHFHIR_LLM_THINKING=adaptive

# --- Kostenschaetzung ------------------------------------------------------
# Preise je 1 Mio. Token in USD. Leer lassen -> interne Tabelle wird benutzt.
# SYNTHFHIR_PRICE_IN_USD=1.0
# SYNTHFHIR_PRICE_OUT_USD=5.0
# Naeherungswert fuer die Umrechnung USD -> EUR im Bericht.
SYNTHFHIR_EUR_PER_USD=0.92

# Harte Notbremse: Messreihe abbrechen, sobald die geschaetzten Kosten diesen
# Wert (EUR) ueberschreiten. Abschnitt 3 der Spec nennt ca. 5 EUR als Rahmen.
SYNTHFHIR_BUDGET_LIMIT_EUR=5.0

# --- Validierungsserver (HAPI FHIR, lokal via Docker) ----------------------
SYNTHFHIR_FHIR_BASE_URL=http://localhost:8080/fhir
# Der allererste $validate-Aufruf ist langsam: HAPI lädt dabei die
# Validierungsartefakte nach. Darum großzügig bemessen.
SYNTHFHIR_FHIR_TIMEOUT_S=120
SYNTHFHIR_FHIR_READINESS_TIMEOUT_S=300

# --- Ablauf ----------------------------------------------------------------
SYNTHFHIR_MAX_REPAIR_ROUNDS=3        # Abschnitt 6.6: maximal 3 Korrekturrunden
SYNTHFHIR_MAX_GENERATION_ATTEMPTS=3  # Abschnitt 8: begrenzte Wiederholung
SYNTHFHIR_OUTPUT_DIR=output
SYNTHFHIR_SCENARIOS_FILE=scenarios.yaml

# --- Demo-Betrieb der veröffentlichten Seite -------------------------------
# Ohne eigenen Schlüssel bedient die Seite Besucher mit dem Schlüssel des
# Betreibers - begrenzt, weil das Gratiskontingent für rund eine Anfrage pro
# Minute reicht, für alle Besucher zusammen.
SYNTHFHIR_DEMO_ANFRAGEN=5
SYNTHFHIR_DEMO_FENSTER_S=3600
